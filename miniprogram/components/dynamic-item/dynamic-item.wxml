<view class="dynamic-item card">
  <!-- 用户信息 -->
  <view class="dynamic-header" style="display:flex; flex-direction:row; align-items:center; padding:0 0 20rpx 0;">
    <user-avatar src="{{item.userInfo.avatarUrl}}" size="medium"></user-avatar>
    <view style="flex:1; margin-left:16rpx; display:flex; flex-direction:column;">
      <text style="font-size:30rpx; font-weight:bold; color:#1a1a1a; margin-bottom:6rpx;">{{item.userInfo.nickName}}</text>
      <text style="font-size:22rpx; color:#999;">{{item.displayTime || item.createTime}}</text>
    </view>
    <view class="header-actions">
      <text wx:if="{{showEdit}}" class="header-action-icon" catch:tap="onEdit" data-id="{{item._id}}">编辑</text>
    </view>
  </view>

  <!-- 游龙内容 - 根据 displayType 展示不同样式 -->

  <!-- 大图模式 (large) -->
  <view wx:if="{{item.displayType === 'large'}}" class="dynamic-large-mode">
    <view class="large-image-wrapper mt-base" wx:if="{{item.images && item.images.length > 0}}">
      <image
        class="large-image"
        src="{{item.images[0]}}"
        mode="aspectFill"
        lazy-load="{{true}}"
        bindtap="onImageTap"
        data-index="0"
        data-images="{{item.images}}">
      </image>
    </view>
    <view class="large-content mt-base">
      <text class="large-title text-lg font-bold">{{item.title}}</text>
      <text class="large-subtitle text-sm text-secondary mt-xs" wx:if="{{item.subtitle}}">{{item.subtitle}}</text>
      <text class="content-text mt-sm" wx:if="{{item.content}}">{{item.content}}</text>
    </view>
  </view>

  <!-- 视频模式 (video) -->
  <view wx:elif="{{item.displayType === 'video'}}" class="dynamic-video-mode">
    <view class="video-wrapper mt-base" wx:if="{{item.video}}">
      <video class="feed-video" 
        style="width: 100%;height:50vw;border-radius: 20rpx;" 
        src="{{item.video}}" 
        controls
        show-center-play-btn="{{onList?false:true}}" 
        show-fullscreen-btn="{{onList?false:true}}" 
        show-progress="{{onList?false:true}}" 
        show-play-btn="{{onList?false:true}}" 
        enable-progress-gesture="{{onList?false:true}}" 
        title="{{item.title}}"
        object-fit="cover"></video>
    </view>
    <view class="video-content mt-base">
      <text class="video-title text-lg font-bold" wx:if="{{item.title}}">{{item.title}}</text>
      <text class="video-subtitle text-sm text-secondary mt-xs" wx:if="{{item.subtitle}}">{{item.subtitle}}</text>
      <text class="content-text mt-sm" wx:if="{{item.content}}">{{item.content}}</text>
    </view>
  </view>

  <!-- 九宫格模式 (grid9) 或默认 -->
  <view wx:elif="{{item.displayType === 'grid9' || (!item.displayType && item.images && item.images.length > 0)}}" class="dynamic-grid-mode">
    <view class="dynamic-content mt-base" wx:if="{{item.content}}">
      <text class="content-text">{{item.content}}</text>
    </view>

    <!-- 图片九宫格 -->
    <view
      class="dynamic-images mt-base {{item.images.length === 1 ? 'single-image' : ''}} {{item.images.length === 2 ? 'double-image' : ''}}"
      wx:if="{{item.images && item.images.length > 0}}">
      <image
        wx:for="{{item.images}}"
        wx:for-item="imageUrl"
        wx:for-index="imgIndex"
        wx:key="imgIndex"
        class="dynamic-image"
        src="{{imageUrl}}"
        mode="aspectFill"
        lazy-load="{{true}}"
        show-menu-by-longpress="{{true}}"
        bindtap="onImageTap"
        data-index="{{imgIndex}}"
        data-images="{{item.images}}">
      </image>
    </view>
  </view>

  <!-- 纯文本模式 (text) -->
  <view wx:else class="dynamic-text-mode">
    <view class="dynamic-content mt-base">
      <text class="content-text">{{item.content}}</text>
    </view>
  </view>

  <!-- 位置信息 -->
  <view class="dynamic-location flex-row align-center mt-base" bindtap="onComment" data-id="{{item._id}}" wx:if="{{item.location}}">
    <text class="location-icon text-sm">📍</text>
    <text class="location-text text-sm text-secondary">{{item.location.address || item.location.name}}</text>
  </view>

  <!-- 操作栏 -->
  <view wx:if="{{isShow && youLongShow && !hideActions}}" class="dynamic-actions flex-between mt-lg pt-base border-top">
    <view class="action-btn {{item.isSubscribed ? 'subscribed' : ''}}" catch:tap="onSubscribe">
      <text class="action-icon">{{item.isSubscribed ? '🔔' : '🔕'}}</text>
      <text class="action-text text-sm">{{item.isSubscribed ? '已订阅' : '订阅'}}</text>
    </view>
    <view class="action-btn">
      <text class="action-icon">💬</text>
      <text class="action-text text-sm">{{item.commentsCount || 0}}</text>
    </view>
    <button class="action-btn share-btn" open-type="share" catch:tap="onShare" data-id="{{item._id}}">
      <text class="action-icon">↗</text>
      <text class="action-text text-sm">分享</text>
    </button>
  </view>
</view>
