<view class="mine-page">
  <!-- 用户卡片 -->
  <view class="user-card">
    <view class="user-row" bindtap="{{isLogin ? 'editProfile' : 'goToLogin'}}">
      <view class="avatar-ring">
        <user-avatar src="{{userInfo.avatarUrl}}" size="large"></user-avatar>
      </view>
      <view class="user-body">
        <text class="user-name">{{userInfo.nickName}}</text>
        <text class="user-sig">{{userInfo.signature || '点击登录，开启游泳之旅'}}</text>
      </view>
      <text class="user-arrow" wx:if="{{isLogin}}">›</text>
    </view>

    <!-- 社交数据 -->
    <view class="social-row" wx:if="{{isLogin}}">
      <view class="social-item" wx:if="{{youLongShow}}">
        <text class="social-num">{{userInfo.stats.dynamicsCount || 0}}</text>
        <text class="social-label">游龙</text>
      </view>
      <view class="social-item">
        <text class="social-num">{{userInfo.stats.followersCount || 0}}</text>
        <text class="social-label">粉丝</text>
      </view>
      <view class="social-item">
        <text class="social-num">{{userInfo.stats.subscriptionsCount || 0}}</text>
        <text class="social-label">订阅</text>
      </view>
    </view>
  </view>

  <!-- 今日游泳状态 -->
  <view class="today-strip" wx:if="{{isLogin}}">
    <view class="strip-left">
      <text class="strip-emoji">{{todayChecked ? '✅' : '🌊'}}</text>
      <view class="strip-text">
        <text class="strip-title">{{todayChecked ? '今日已打卡' : '今天还没打卡'}}</text>
        <text class="strip-sub" wx:if="{{todayChecked && todayDistance > 0}}">游了 {{todayDistance}}m</text>
      </view>
    </view>
    <view class="strip-cta" bindtap="goToSwimRecords">
      <text>{{todayChecked ? '查看' : '去打卡'}}</text>
    </view>
  </view>

  <!-- 本月游泳概览 -->
  <view class="swim-overview" wx:if="{{isLogin}}">
    <view class="overview-card">
      <text class="overview-val">{{monthDistance}}</text>
      <text class="overview-unit">m</text>
      <text class="overview-label">本月共游</text>
    </view>
    <view class="overview-card">
      <text class="overview-val">{{bestPaceEmoji}} {{bestPaceFormatted || '--:--'}}</text>
      <text class="overview-label">最佳 PB</text>
    </view>
    <view class="overview-card">
      <text class="overview-val">{{totalDistance}}</text>
      <text class="overview-unit">m</text>
      <text class="overview-label">累计距离</text>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-section">
    <view class="menu-group-title">我的内容</view>
    <view class="menu-card" bindtap="goToMyDynamics" wx:if="{{youLongShow}}">
      <view class="menu-icon icon-dynamics">📝</view>
      <text class="menu-label">我的游龙</text>
      <text class="menu-extra" wx:if="{{userInfo.stats.dynamicsCount}}">{{userInfo.stats.dynamicsCount}}</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-card" bindtap="goToMySubscriptions">
      <view class="menu-icon icon-subs">⭐</view>
      <text class="menu-label">管理订阅</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-card" bindtap="goToSwimRecords" wx:if="{{youLongShow}}">
      <view class="menu-icon icon-records">📊</view>
      <text class="menu-label">游龙纪录</text>
      <text class="menu-extra" wx:if="{{monthActiveDays > 0}}">{{monthActiveDays}}天</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-card" bindtap="goToMyCompetitions" wx:if="{{isLogin && youLongShow && userInfo.isDiamond}}">
      <view class="menu-icon icon-comp">🏆</view>
      <text class="menu-label">预约参赛</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-card" bindtap="goToCompetitions" wx:if="{{isLogin && youLongShow && userInfo.isDiamond}}">
      <view class="menu-icon icon-race">🏊</view>
      <text class="menu-label">公开赛</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="menu-section">
    <view class="menu-group-title">其他</view>
    <view class="menu-card" bindtap="goToSettings">
      <view class="menu-icon icon-settings">⚙</view>
      <text class="menu-label">设置</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="bottom-safe"></view>
</view>
