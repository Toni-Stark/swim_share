<view class="login-page page">
  <view class="login-container">
    <!-- Logo区域 -->
    <view class="logo-section">
      <image class="logo" src="https://lovebeyonddays.com/common/default-avatar.png" mode="aspectFill"></image>
      <text class="app-name">哔哔浪浪</text>
    </view>

    <!-- 介绍文字 -->
    <view class="intro-section">
      <text class="intro-title">欢迎使用</text>
      <text class="intro-desc">登录后可以浏览官方内容、发布游龙、管理个人信息</text>
    </view>

    <!-- 用户协议确认 -->
    <view class="agreement-section">
      <view class="agreement-check" bindtap="toggleAgree">
        <view class="checkbox {{agreed ? 'checked' : ''}}">
          <text wx:if="{{agreed}}" class="check-icon">✓</text>
        </view>
        <view class="agreement-text">
          <text>我已阅读并同意</text>
          <text class="link" catchtap="openAgreement">《用户协议》</text>
          <text>和</text>
          <text class="link" catchtap="openPrivacy">《隐私政策》</text>
        </view>
      </view>
    </view>

    <!-- 登录按钮 -->
    <view class="button-section">
      <button class="login-btn {{agreed ? '' : 'disabled'}}" bindtap="handleLogin" disabled="{{!agreed}}">
        微信登录
      </button>
    </view>
    <view class="back_text" catch:tap="backHome">退出登录</view>
  </view>
</view>
