<view class="detail-page">
  <view wx:if="{{youLongShow}}">
  <view class="detail-card" wx:if="{{competition}}">
    <view class="detail-header">
      <text class="detail-name">{{competition.name}}</text>
      <view class="detail-status {{competition.status === 'ended' ? 'ended' : 'upcoming'}}">
        {{competition.status === 'ended' ? '已结束' : '即将开始'}}
      </view>
    </view>

    <image wx:if="{{competition.coverImage}}" class="detail-cover" src="{{competition.coverImage}}" mode="aspectFill" />

    <view class="detail-meta">
      <view class="dm-item">
        <text class="dm-icon">📅</text>
        <text class="dm-text">{{competition.date}}</text>
      </view>
      <view class="dm-item">
        <text class="dm-icon">📍</text>
        <text class="dm-text">{{competition.location}}</text>
      </view>
      <view class="dm-item" wx:if="{{competition.registrantCount > 0}}">
        <text class="dm-icon">👥</text>
        <text class="dm-text">{{competition.registrantCount}}人报名</text>
      </view>
    </view>

    <view class="detail-desc" wx:if="{{competition.description}}">
      <text class="desc-text">{{competition.description}}</text>
    </view>

    <view class="detail-divider"></view>

    <block wx:if="{{competition.status === 'ended'}}">
      <text class="section-title">🏅 比赛结果</text>
      <view class="podium" wx:if="{{competition.topThree && competition.topThree.length > 0}}">
        <view class="podium-item" wx:for="{{competition.topThree}}" wx:key="rank">
          <view class="podium-rank rank-{{item.rank}}">
            <text wx:if="{{item.rank === 1}}">🥇</text>
            <text wx:elif="{{item.rank === 2}}">🥈</text>
            <text wx:elif="{{item.rank === 3}}">🥉</text>
            <text wx:else>{{item.rank}}</text>
          </view>
          <text class="podium-name">{{item.name}}</text>
          <text class="podium-time">{{item.time}}</text>
        </view>
      </view>
      <view wx:else class="empty-tip">暂无比赛结果</view>
    </block>

    <block wx:if="{{competition.status === 'upcoming'}}">
      <view class="reg-section">
        <view wx:if="{{myRegStatus === 'pending'}}" class="reg-status-card pending">
          <text class="reg-status-icon">⏳</text>
          <text class="reg-status-text">已提交意向，等待审核</text>
        </view>
        <view wx:elif="{{myRegStatus === 'approved'}}" class="reg-status-card approved">
          <text class="reg-status-icon">✅</text>
          <text class="reg-status-text">报名已通过</text>
        </view>
        <view wx:elif="{{myRegStatus === 'rejected'}}" class="reg-status-card rejected">
          <text class="reg-status-icon">❌</text>
          <text class="reg-status-text">报名未通过</text>
        </view>
        <view wx:else class="interest-btn" bindtap="openPhoneModal">
          <text class="interest-btn-text">提交意向</text>
        </view>
      </view>
    </block>

    <block wx:if="{{isAdmin && competition.status === 'upcoming'}}">
      <view class="detail-divider"></view>
      <text class="section-title">📋 报名管理 ({{registrations.length}}人)</text>

      <view class="loading-tip" wx:if="{{loadingRegs}}">
        <text>加载中...</text>
      </view>

      <view class="admin-reg-list" wx:elif="{{registrations.length > 0}}">
        <view class="admin-reg-card" wx:for="{{registrations}}" wx:key="_id">
          <view class="arc-header">
            <view class="arc-user">
              <text class="arc-badge">{{item.userStats.tierBadge || '🏊'}}</text>
              <view class="arc-user-info">
                <text class="arc-name">{{item.nickName}}</text>
                <text class="arc-tier">{{item.userStats.tierName || '游泳爱好者'}}</text>
              </view>
            </view>
            <view class="arc-status-tag {{item.status}}">
              <text wx:if="{{item.status === 'pending'}}">待审核</text>
              <text wx:elif="{{item.status === 'approved'}}">已通过</text>
              <text wx:elif="{{item.status === 'rejected'}}">已驳回</text>
            </view>
          </view>

          <view class="arc-stats">
            <view class="arc-stat">
              <text class="arc-stat-label">最佳PB</text>
              <text class="arc-stat-val">{{item.userStats.bestPBEmoji || '⏱'}} {{item.userStats.bestPB || '--'}}</text>
            </view>
            <view class="arc-stat">
              <text class="arc-stat-label">泳姿</text>
              <text class="arc-stat-val">{{item.userStats.bestPBStroke || '--'}}</text>
            </view>
            <view class="arc-stat">
              <text class="arc-stat-label">累计距离</text>
              <text class="arc-stat-val">{{item.userStats.totalDistance || 0}}m</text>
            </view>
          </view>

          <view class="arc-phone" bindtap="callPhone" data-phone="{{item.phone}}">
            <text class="arc-phone-icon">📞</text>
            <text class="arc-phone-text">{{item.phone}}</text>
          </view>

          <view class="arc-actions" wx:if="{{item.status === 'pending'}}">
            <view class="arc-btn approve" catchtap="reviewReg" data-id="{{item._id}}" data-status="approved">
              <text>通过</text>
            </view>
            <view class="arc-btn reject" catchtap="reviewReg" data-id="{{item._id}}" data-status="rejected">
              <text>驳回</text>
            </view>
          </view>
        </view>
      </view>

      <view wx:else class="empty-tip">暂无报名</view>
    </block>
  </view>

  <view wx:else class="empty-tip" style="padding-top: 200rpx;">加载赛事信息中...</view>

  <view class="phone-modal" wx:if="{{showPhoneModal}}" catchtouchmove="true">
    <view class="pm-mask" bindtap="closePhoneModal"></view>
    <view class="pm-content">
      <view class="pm-header">
        <text class="pm-title">提交参赛意向</text>
        <text class="pm-close" bindtap="closePhoneModal">✕</text>
      </view>
      <text class="pm-desc">提交后管理员会查看你的游泳数据，审核通过后即完成报名</text>
      <view class="pm-input-wrap">
        <text class="pm-label">手机号</text>
        <input class="pm-input" type="number" maxlength="11" placeholder="请输入手机号" value="{{phone}}" bindinput="onPhoneInput" />
      </view>
      <button class="pm-submit" bindtap="submitInterest" disabled="{{submitting}}">
        {{submitting ? '提交中...' : '确认提交'}}
      </button>
    </view>
  </view>
  </view>

  <view class="empty-tip" wx:if="{{!youLongShow}}" style="padding-top: 200rpx;">
    <text>功能暂未开放</text>
  </view>
</view>
