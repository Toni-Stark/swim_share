<view class="detail-page">
  <!-- 动态内容 -->
  <view class="post-section {{isOwner ? 'has-delete' : ''}}" wx:if="{{dynamic}}">
    <view class="post-header-bar" wx:if="{{isOwner}}">
      <view class="delete-btn" bindtap="onDeleteDynamic">
        <text class="delete-icon">🗑</text>
        <text>删除</text>
      </view>
    </view>
    <dynamic-item
      item="{{dynamic}}"
      isShow="{{isShow}}"
      youLongShow="{{youLongShow}}"
      hideActions="{{false}}"
      bind:subscribe="onDynamicSubscribe"
      bind:share="onShare">
    </dynamic-item>
  </view>

  <!-- 评论区 -->
  <view class="comments-section">
    <view class="section-header">
      <text class="header-icon">💬</text>
      <text class="header-text">评论</text>
      <text class="header-count" wx:if="{{dynamic.commentsCount > 0}}">{{dynamic.commentsCount}}</text>
    </view>

    <!-- 热门评论 -->
    <view class="hot-zone" wx:if="{{commentsList.length >= 3}}">
      <view class="hot-tag">
        <text>🔥 热门</text>
      </view>
      <view
        class="comment-card hot-card"
        wx:for="{{hotComments}}"
        wx:key="_id">
        <view class="card-left">
          <user-avatar src="{{item.userInfo.avatarUrl}}" size="medium"></user-avatar>
        </view>
        <view class="card-right">
          <view class="card-row">
            <text class="card-name hot-name">{{item.userInfo.nickName}}</text>
            <text class="card-time">{{item.displayTime || item.createTime}}</text>
            <view class="hot-likes">
              <text>⚡{{item.likesCount || 0}}</text>
            </view>
          </view>
          <text class="card-text">{{item.content}}</text>
          <view class="card-reply" wx:if="{{item.replyToUser}}">
            <text class="reply-mark">↩</text>
            <text>{{item.replyToUser.nickName}}</text>
          </view>
        </view>
      </view>
      <view class="divider-row">
        <view class="divider"></view>
        <text class="divider-label">全部评论</text>
        <view class="divider"></view>
      </view>
    </view>

    <!-- 常规评论 -->
    <view
      class="comment-card {{index % 2 === 0 ? 'card-tint-a' : 'card-tint-b'}} {{item.isMine ? 'card-mine' : ''}}"
      wx:for="{{regularComments}}"
      wx:key="_id"
      style="animation-delay: {{index * 0.04}}s;">
      <view class="card-left">
        <user-avatar src="{{item.userInfo.avatarUrl}}" size="medium"></user-avatar>
      </view>
      <view class="card-right">
        <view class="card-row">
          <text class="card-name">{{item.userInfo.nickName}}</text>
          <text class="card-time">{{item.displayTime || item.createTime}}</text>
          <view class="card-spacer"></view>
          <view
            wx:if="{{isShow && youLongShow}}"
            class="card-like {{item.isLiked ? 'liked' : ''}}"
            catchtap="onCommentLike"
            data-id="{{item._id}}">
            <text>{{item.isLiked ? '❤️' : '🤍'}}</text>
            <text wx:if="{{item.likesCount > 0}}" class="like-num">{{item.likesCount}}</text>
          </view>
        </view>
        <text class="card-text">{{item.content}}</text>
        <view class="card-reply" wx:if="{{item.replyToUser}}">
          <text class="reply-mark">↩</text>
          <text>{{item.replyToUser.nickName}}</text>
        </view>
      </view>
    </view>

    <!-- 加载中 -->
    <view class="load-hint" wx:if="{{loading}}">
      <text>加载中...</text>
    </view>

    <!-- 空状态 -->
    <view class="comments-empty" wx:if="{{commentsList.length === 0 && !loading}}">
      <text class="empty-emoji">🫧</text>
      <text class="empty-title">还没有评论</text>
      <text class="empty-sub">说点什么，做个第一个发声的人 ~</text>
    </view>
  </view>
</view>

<!-- 输入栏 -->
<view wx:if="{{isShow && youLongShow}}" class="input-bar">
  <view class="input-row">
    <input
      class="input-pill"
      type="text"
      placeholder="扔一个漂流瓶..."
      placeholder-class="text-placeholder"
      value="{{commentContent}}"
      bindinput="onCommentInput"
      confirm-type="send"
      bindconfirm="submitComment">
    </input>
    <button class="send-btn" bindtap="submitComment">发送</button>
  </view>
</view>