<view class="dynamics-page page">
  <!-- 发布按钮 -->
  <view wx:if="{{openid && isShow && youLongShow}}" class="publish-btn" bindtap="goToPublish">
    <text class="publish-icon">+</text>
  </view>

  <!-- 筛选按钮 -->
  <view wx:if="{{openid && youLongShow}}" class="filter-btn {{filterSubscribed ? 'active' : ''}}" bindtap="toggleFilter">
    <text class="filter-icon">⚓</text>
  </view>

  <!-- 混合内容流 -->
  <view class="dynamics-list container" wx:if="{{youLongShow}}">
    <view class="loading-state" wx:if="{{loading && feedCards.length === 0}}">
      <text class="loading-text">加载中...</text>
    </view>

    <block wx:else>
      <block wx:for="{{feedCards}}" wx:key="_id">
        <view wx:if="{{item.cardType === 'dynamic'}}" bindtap="onCardTap" data-id="{{item._id}}">
          <dynamic-item
            item="{{item}}"
            isShow="{{isShow}}"
            youLongShow="{{youLongShow}}"
            hideActions="{{true}}"
            bind:userTap="onUserTap"
            bind:subscribe="onSubscribe"
            bind:comment="onComment"
            bind:share="onShare"
            bind:delete="onDelete">
          </dynamic-item>
        </view>
        <view wx:elif="{{item.cardType === 'competition'}}" bindtap="onCompTap" data-id="{{item._id}}">
          <ad-card item="{{item}}" bind:share="onAdShare"></ad-card>
        </view>
        <view wx:elif="{{item.cardType === 'ad'}}" bindtap="onAdTap" data-id="{{item._id}}">
          <ad-card item="{{item}}" bind:share="onAdShare"></ad-card>
        </view>
        <view wx:elif="{{item.cardType === 'official'}}" bindtap="onOfficialTap" data-id="{{item._id}}">
          <official-card item="{{item}}" bind:share="onOfficialShare"></official-card>
        </view>
      </block>

      <view class="empty-state" wx:if="{{feedCards.length === 0 && !loading}}">
        <view class="empty-art">
          <view class="art-circle c1"></view>
          <view class="art-circle c2"></view>
          <view class="art-circle c3"></view>
          <text class="art-emoji">🏊</text>
        </view>
        <text class="empty-text">暂无游龙</text>
      </view>

      <view class="load-more" wx:if="{{feedCards.length > 0}}">
        <text class="load-more-text">{{hasMore ? '上拉加载更多' : '没有更多了'}}</text>
      </view>
    </block>
  </view>

  <!-- 功能未开放 -->
  <view class="empty-state" wx:if="{{!youLongShow}}" style="padding-top: 200rpx;">
    <text class="empty-text" style="font-size:32rpx;color:#999;">功能暂未开放</text>
  </view>
</view>
