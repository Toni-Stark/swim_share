<view class="edit-page" wx:if="{{youLongShow}}">
    <!-- 展示方式选择 - 可视化预览卡片 -->
    <view class="section">
      <view class="section-header">
        <text class="section-icon">🎨</text>
        <text class="section-title">选择展示方式</text>
      </view>
      <view class="type-cards">
        <view
          wx:for="{{displayTypes}}"
          wx:key="value"
          class="type-card {{displayType === item.value ? 'selected' : ''}}"
          data-type="{{item.value}}"
          bindtap="onDisplayTypeTap">
          <text class="type-icon">{{item.icon}}</text>
          <text class="type-label">{{item.label}}</text>
          <text class="type-desc">{{item.desc}}</text>
        </view>
      </view>
    </view>

    <!-- 当前选中类型的高亮标签 -->
    <view class="active-type-badge">
      <text class="badge-icon">{{displayTypeInfo.icon}}</text>
      <text>{{displayTypeInfo.label}}模式</text>
    </view>

    <!-- 视频模式 -->
    <view class="section" wx:if="{{displayType === 'video'}}">
      <view class="upload-zone" bindtap="chooseVideo" wx:if="{{!video}}">
        <view class="upload-icon-wrap">
          <text class="upload-icon">🎬</text>
        </view>
        <text class="upload-title">点击上传视频</text>
        <text class="upload-hint">支持 MP4 格式，最长 2 分钟</text>
      </view>
      <view class="input-group">
        <text class="input-label">描述</text>
        <textarea class="edit-ta" placeholder="对视频做个描述..." value="{{content}}" bindinput="onContentInput" maxlength="500" auto-height></textarea>
      </view>
    </view>

    <!-- 九宫格 -->
    <view class="section" wx:if="{{displayType === 'grid9'}}">
      <view class="input-group">
        <text class="input-label">文本内容</text>
        <textarea class="edit-ta" placeholder="分享新鲜事..." value="{{content}}" bindinput="onContentInput" maxlength="500" auto-height></textarea>
      </view>
      <view class="input-group">
        <text class="input-label">图片 <text class="label-hint">({{images.length}}/9)</text></text>
        <view class="img-masonry">
          <view class="img-cell" wx:for="{{images}}" wx:key="index">
            <image class="cell-img" src="{{item}}" mode="aspectFill"></image>
            <view class="cell-del" catchtap="deleteImage" data-index="{{index}}">
              <text>×</text>
            </view>
          </view>
          <view class="img-add-cell" bindtap="chooseImages" wx:if="{{images.length < 9}}">
            <view class="add-inner">
              <text class="add-plus">+</text>
              <text class="add-hint">添加</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 大图 -->
    <view class="section" wx:if="{{displayType === 'large'}}">
      <view class="input-group">
        <text class="input-label">标题 <text class="label-required">*</text></text>
        <input class="edit-inp" placeholder="输入一个吸引人的标题..." value="{{title}}" bindinput="onTitleInput" maxlength="50"/>
      </view>
      <view class="input-group">
        <text class="input-label">封面图</text>
        <view class="img-masonry">
          <view class="img-cell large-cell" wx:if="{{images.length > 0}}">
            <image class="cell-img" src="{{images[0]}}" mode="aspectFill"></image>
            <view class="cell-del" catchtap="deleteImage" data-index="0">
              <text>×</text>
            </view>
          </view>
          <view class="img-add-cell large-cell" bindtap="chooseImages" wx:else>
            <view class="add-inner">
              <text class="add-plus">+</text>
              <text class="add-hint">封面</text>
            </view>
          </view>
        </view>
      </view>
      <view class="input-group">
        <text class="input-label">描述</text>
        <textarea class="edit-ta" placeholder="描述..." value="{{content}}" bindinput="onContentInput" maxlength="500" auto-height></textarea>
      </view>
    </view>

    <!-- 纯文本 -->
    <view class="section" wx:if="{{displayType === 'text'}}">
      <view class="input-group">
        <text class="input-label">文字内容</text>
        <textarea class="edit-ta text-large" placeholder="写下你的想法..." value="{{content}}" bindinput="onContentInput" maxlength="1000" auto-height></textarea>
      </view>
    </view>

    <!-- 位置信息 -->
    <view class="section">
      <view class="location-wrap" wx:if="{{!location}}" bindtap="chooseLocation">
        <view class="loc-icon-wrap">
          <text class="loc-icon">📍</text>
        </view>
        <text class="loc-text">添加位置信息</text>
        <text class="loc-arrow">+</text>
      </view>
      <view class="location-wrap active" wx:if="{{location}}">
        <view class="loc-icon-wrap filled">
          <text class="loc-icon">📍</text>
        </view>
        <text class="loc-text">{{location.address || location.name}}</text>
        <view class="loc-remove" bindtap="removeLocation">
          <text>✕</text>
        </view>
      </view>
    </view>


  <!-- 视频播放区（scroll-view 外，避免原生组件冲突） -->
  <view class="video-section" wx:if="{{displayType === 'video' && video}}">
    <video
      class="video-full"
      src="{{video}}"
      object-fit="fill"
      controls
      show-center-play-btn="{{true}}"
      show-fullscreen-btn="{{true}}">
    </video>
    <view class="upload-spot" wx:if="{{uploading}}">
      <view class="upload-spot-ring"></view>
      <text class="upload-spot-text">{{uploadProgress}}%</text>
    </view>
    <view class="video-actions-bar">
      <view class="va-btn change" bindtap="chooseVideo">更换视频</view>
      <view class="va-btn remove" bindtap="deleteVideo">移除</view>
    </view>
  </view>
  <view style="height: 140rpx;"></view>

  <!-- 保存栏 -->
  <view class="save-bar">

    <button class="save-btn" type="primary" disabled="{{submitting}}" bindtap="save">
      <text class="save-btn-text">{{submitting ? '保存中...' : '保存修改'}}</text>
    </button>
  </view>
</view>